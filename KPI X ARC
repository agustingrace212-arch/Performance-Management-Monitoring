              kpiData.find(r => nama && normText(r.nama) === normText(nama));
  const outcomes = (parsed.outcomes || []).filter(o => o && (cellText(o.outcome) || parseFloat(o.bobot) || parseFloat(o.target) || parseFloat(o.realisasi) || parseFloat(o.arcA) || parseFloat(o.arcR) || parseFloat(o.arcC)));
  const nilaiAkhir = outcomes.reduce((sum, o) => sum + getKpiPctScore(o).score, 0);
  const arcScore = calcWeightedArcFromOutcomes(outcomes);

  return {
    nama: emp ? emp.nama : nama,
    nik: emp ? emp.nik : nik,
    jabatan: emp ? emp.jabatan : cellText(parsed.jabatan),
    joinDate: cellText(parsed.joinDate),
