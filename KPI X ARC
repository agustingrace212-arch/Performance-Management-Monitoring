  const body=document.getElementById('dashArcBody'); if(!body) return;
  if(!filteredRows.length){
    body.innerHTML='<tr><td colspan="7" style="text-align:center;padding:36px;color:#9aaac8">Tidak ada karyawan pada kategori ini.</td></tr>';
    return;
  }
  body.innerHTML = filteredRows.map((r,i)=>{
    const f=getArcFlag(r.average);
    return `<tr>
      <td style="color:#9aaac8;font-weight:700">${i+1}</td>
      <td><strong>${arcEsc(r.nama||'—')}</strong></td>
      <td><span class="period-badge">${arcEsc(r.nik||'—')}</span></td>
      <td>${arcEsc(r.jabatan||'—')}</td>
      <td>${arcEsc(r.direktorat||'—')}</td>
      <td style="text-align:center;font-weight:900;color:${arcBarColor(r.average)}">${arcScoreLabel(r.average)}</td>
      <td style="text-align:center"><span class="flag ${f.cls}">${arcEsc(f.label)}</span></td>
    </tr>`;
  }).join('');
}

// ── MODAL ────────────────────────────────────────────
function openArcModal(idx) {
  const row=arcData[idx], eff=Object.assign({},row,arcEdited[row.nik]||{});
  document.getElementById('arcEditIdx').value    =idx;
  document.getElementById('arcEditNama').value   =eff.nama;
  document.getElementById('arcEditNik').value    =eff.nik;
  document.getElementById('arcEditJabatan').value=eff.jabatan||'';
  ['2026h1','2025h2','2025h1','2024h2'].forEach((k,i)=>{
    const fkey=['arc_2026_h1','arc_2025_h2','arc_2025_h1','arc_2024_h2'][i];
    const pkey=['pred_2026_h1','pred_2025_h2','pred_2025_h1','pred_2024_h2'][i];
    document.getElementById('arcEdit'+k).value=eff[fkey]!==null?eff[fkey]:'';
    document.getElementById('arcPred'+k).textContent=row[pkey]?`Predikat asli: ${row[pkey]}`:'';
  });
  arcUpdateModalAvg();
  document.getElementById('arcModalBg').classList.add('open');
}

function arcUpdateModalAvg() {
  const vals=['arcEdit2026h1','arcEdit2025h2','arcEdit2025h1','arcEdit2024h2']
    .map(id=>{const v=document.getElementById(id).value.trim();return v===''?null:parseFloat(v);})
    .filter(v=>v!==null&&!isNaN(v));
  const avg=vals.length?(vals.reduce((a,b)=>a+b,0)/vals.length).toFixed(2):null;
  const el=document.getElementById('arcModalAvg');
  if(avg!==null){el.textContent=avg+' — '+arcPredikat(parseFloat(avg));el.style.color=arcBarColor(parseFloat(avg));}
  else{el.textContent='—';el.style.color='#94a3b8';}
}

function closeArcModal(){document.getElementById('arcModalBg').classList.remove('open');}

function saveArcModal() {
  const idx=parseInt(document.getElementById('arcEditIdx').value);
  const nik=arcData[idx].nik;
  const pv=id=>{const v=document.getElementById(id).value.trim();return v===''?null:parseFloat(v);};
  const vals={arc_2026_h1:pv('arcEdit2026h1'),arc_2025_h2:pv('arcEdit2025h2'),arc_2025_h1:pv('arcEdit2025h1'),arc_2024_h2:pv('arcEdit2024h2')};
  for(const[k,v]of Object.entries(vals)){if(v!==null&&(v<1||v>5)){showToast('⚠️ Nilai ARC harus antara 1–5');return;}}
  if(!arcEdited[nik]) arcEdited[nik]={};
  Object.assign(arcEdited[nik],vals);
  const av=Object.values(vals).filter(v=>v!==null);
  arcEdited[nik].average=av.length?parseFloat((av.reduce((a,b)=>a+b,0)/av.length).toFixed(2)):null;
  closeArcModal(); renderArcTable();
  if(arcSelectedNik===nik){const i=arcData.findIndex(r=>r.nik===nik);if(i>=0)arcShowSelectedCard(i);}
  showToast('✅ Data ARC '+arcData[idx].nama+' diperbarui');
}

document.getElementById('arcModalBg').addEventListener('click',function(e){if(e.target===this)closeArcModal();});

function saveArcData(){showToast('💾 Data ARC tersimpan — '+Object.keys(arcEdited).length+' karyawan diedit');}
function clearArcEdits(){
  if(!confirm('Reset semua perubahan ARC manual?')) return;
  arcEdited={};arcClearSearch();renderArcTable();showToast('🗑️ Perubahan ARC direset');
}
function exportArcCSV(){
  let csv='No,NIK,Nama Karyawan,Jabatan,Direktorat,Business Unit,ARC 2026 H-1,ARC 2025 H-2,ARC 2025 H-1,ARC 2024 H-2,Rata-rata,Status\n';
  arcData.forEach((r,i)=>{
    const eff=Object.assign({},r,arcEdited[r.nik]||{});const f=getArcFlag(eff.average);
    csv+=`${i+1},"${eff.nik}","${eff.nama}","${eff.jabatan||''}","${eff.direktorat||''}","${eff.bu||''}",`+
      `${eff.arc_2026_h1??''},${eff.arc_2025_h2??''},${eff.arc_2025_h1??''},${eff.arc_2024_h2??''},${eff.average??''},"${f.label}"\n`;
  });
  const blob=new Blob([csv],{type:'text/csv'});const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='ARC_Appraisal_Cimory.csv';a.click();
  showToast('📤 Data ARC diekspor');
}

renderArcTable();

</script>
