  };
  return {
    strength:'Kinerja berada pada kategori Red sehingga membutuhkan perhatian khusus dari atasan.',
    weakness:'Performa belum memenuhi ekspektasi minimum dan perlu perbaikan segera pada aspek utama ARC.',
    opportunity:'Buat improvement plan, monitoring berkala, dan pendampingan intensif untuk memastikan perbaikan performa.'
  };
}
function arcGetDetails(row, periodKey){
  const d=row._details||{};
  const onlyAtasan = arr => (arr||[])
    .filter(x => String(x.posisiPenilai||'').trim().toLowerCase() === 'atasan')
    .map(x=>Object.assign({periodKey},x));
  if(periodKey==='average') {
    return ARC_PERIODS.flatMap(k => (d[k]||[])
      .filter(x => String(x.posisiPenilai||'').trim().toLowerCase() === 'atasan')
      .map(x=>Object.assign({periodKey:k},x)));
  }
  return onlyAtasan(d[periodKey]);
}
function arcAvgDetail(nums){
  const arr=nums.filter(v=>v!==null&&v!==undefined&&!isNaN(v));
  if(!arr.length) return null;
  return arr.reduce((a,b)=>a+Number(b),0)/arr.length;
}
function arcAssessmentRows(details){
  if(!details.length) return '<tr><td colspan="6" style="text-align:center;color:#64748b">Belum ada detail assessment pada periode ini.</td></tr>';
  return details.map((d,i)=>{
    const c=arcBarColor(d.total);
    return `<tr>
      <td style="text-align:center">${i+1}</td>
      <td>${arcEsc(ARC_PERIOD_LABELS[d.periodKey]||d.periode||'—')}</td>
      <td>${arcEsc(d.posisiPenilai||'—')}</td>
      <td>${arcEsc(d.namaPenilai||'—')}<br><span style="font-size:10px;color:#64748b">${arcEsc(d.jabatanPenilai||'')}</span></td>
      <td>${arcEsc(d.status||'—')}</td>
      <td style="text-align:center;font-weight:900;color:${c}">${arcScoreLabel(d.total)}</td>
    </tr>`;
  }).join('');
}
function arcAspectRowsFromDetails(details){
  const keyMap={
    'Consumer Focus':'consumer_focus',
    'Can Do Attitude':'can_do_attitude',
    'Continuous Learning':'continuous_learning',
    'Prioritize':'prioritize',
    'Plan':'plan',
    'Perform':'perform',
    'Hands On Leadership':'hands_on_leadership',
    'Assertive':'assertive',
    'Caring for Others':'caring_for_others'
  };
  return ARC_ASPECTS.map(a=>{
    if(a.grp) return `<tr class="grp"><td colspan="5">${a.grp}</td></tr>`;
    const key=keyMap[a.aspect];
    const aspectDetails=details.map(d=>({
      score:d.aspects&&d.aspects[key]?d.aspects[key].score:null,
      summary:d.aspects&&d.aspects[key]?d.aspects[key].summary:'',
      penilai:d.namaPenilai||'', posisi:d.posisiPenilai||'', period:d.periodKey||'', status:d.status||''
    })).filter(x=>x.score!==null||x.summary);
    const avg=arcAvgDetail(aspectDetails.map(x=>x.score));
    const scoreHtml=avg===null?'—':arcScoreLabel(avg);
    const summaryHtml=aspectDetails.length
      ? aspectDetails.map(x=>{
          const head=[ARC_PERIOD_LABELS[x.period]||'', x.posisi||'', x.penilai||''].filter(Boolean).join(' · ');
          return `<div style="margin-bottom:8px"><strong>${arcEsc(head||'Detail')}</strong>${x.score!==null?` <span style="color:#1e3a8a">(Score ${arcScoreLabel(x.score)})</span>`:''}<br>${arcEsc(x.summary||'—').replace(/\n/g,'<br>')}</div>`;
        }).join('')
      : '<span style="color:#64748b">Detail per aspek belum tersedia pada data Excel.</span>';
    return `<tr><td style="text-align:center">${a.no}</td><td class="aspect">${arcEsc(a.aspect)}</td><td>${arcEsc(a.desc)}</td><td style="text-align:center;color:#1e3a8a;font-weight:900">${scoreHtml}</td><td>${summaryHtml}</td></tr>`;
  }).join('');
}
function arcQuantRowsFromDetails(details, fallback){
  const make=(label,key,fb)=>{
    const items=details.filter(d=>d[key]).map(d=>{
      const head=[ARC_PERIOD_LABELS[d.periodKey]||'', d.posisiPenilai||'', d.namaPenilai||''].filter(Boolean).join(' · ');
      return `<div style="margin-bottom:8px"><strong>${arcEsc(head||label)}</strong><br>${arcEsc(d[key]).replace(/\n/g,'<br>')}</div>`;
    }).join('');
    return items || arcEsc(fb||'—');
  };
  return `
    <tr><td style="text-align:center">1</td><td><strong>What to Start</strong></td><td>${make('What to Start','whatStart',fallback.opportunity)}</td></tr>
    <tr><td style="text-align:center">2</td><td><strong>What to Stop</strong></td><td>${make('What to Stop','whatStop',fallback.weakness)}</td></tr>
    <tr><td style="text-align:center">3</td><td><strong>What to Continue</strong></td><td>${make('What to Continue','whatContinue',fallback.strength)}</td></tr>`;
}
