// ═══ PAGINATION ══════════════════════════════════════════
let currentPage = 1;
let pageSize = 25;
let totalPages = 1;
let filtered = [];

// ═══ NAV ═════════════════════════════════════════════════
function showPage(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('visible'));
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  const map = {
    kpi: ['page-kpi','tab-kpi'], arc: ['page-arc','tab-arc'],
    dashboard: ['page-dashboard','tab-rekap'], rekap: ['page-rekap-summary','tab-rekap'],
    output: ['page-rekap-detail','tab-output'], 'rekap-detail': ['page-rekap-detail','tab-output'],
    masterdata: ['page-masterdata','tab-masterdata']
  };
  const m = map[page]; if (!m) return;
  document.getElementById(m[0]).classList.add('visible');
  const tab = document.getElementById(m[1]); if (tab) tab.classList.add('active');
  if (page === 'kpi') renderTable();
  if (page === 'arc') renderArcTable();
  if (page === 'dashboard') renderDashboardArc('all');
  if (page === 'rekap') renderRekapSummaryData();
  if (page === 'output' || page === 'rekap-detail') renderRekapData();
  if (page === 'masterdata') renderMasterData();
}

// ═══ FLAG ════════════════════════════════════════════════
function getFlag(skor) {
  if (skor === null || skor === undefined) return {cls:'nodata', label:'Belum Diisi'};
  if (skor >= 80) return {cls:'green',  label:'Baik'};
  if (skor >= 60) return {cls:'yellow', label:'Cukup'};
  return                 {cls:'red',    label:'Perlu Perhatian'};
}
function barColor(skor) {
  if (skor === null) return '#cbd5e1';
  if (skor >= 80) return '#16a34a';
  if (skor >= 60) return '#d97706';
  return '#dc2626';
}

// ═══ FILTER ══════════════════════════════════════════════
function getFiltered() {
  const q   = document.getElementById('searchInput').value.toLowerCase();
  const bu  = document.getElementById('filterBU').value;
  const lvl = document.getElementById('filterPeriod').value;
  const dir = document.getElementById('filterFlag').value;
  return kpiData.filter(r => {
    const text = [r.no, r.bu, r.nik, r.nama, r.jabatan, r.level, r.divisi, r.direktorat].join(' ').toLowerCase();
    const matchQ = !q || text.includes(q);
    const matchBU = !bu || r.bu === bu;
    const matchLvl = !lvl || r.level === lvl;
    const matchDir = !dir || r.direktorat === dir;
    return matchQ && matchBU && matchLvl && matchDir;
  });
}

function esc(v) {
  return String(v ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

// ═══ RENDER TABLE ════════════════════════════════════════
function renderTable() {
  filtered = getFiltered();
  totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
  if (currentPage > totalPages) currentPage = totalPages;

  const start = (currentPage - 1) * pageSize;
  const pageRows = filtered.slice(start, start + pageSize);

  const tbody = document.getElementById('kpiTableBody');
  tbody.innerHTML = '';

  if (pageRows.length === 0) {
    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:36px;color:#9aaac8">Tidak ada data yang cocok</td></tr>';
  } else {
    pageRows.forEach((row, i) => {
      const tr = document.createElement('tr');
      const dataIdx = kpiData.indexOf(row);
      tr.innerHTML = `
        <td style="color:#9aaac8;font-weight:700">${esc(row.no || start+i+1)}</td>
        <td>${esc(row.bu)}</td>
        <td><span class="period-badge">${esc(row.nik)}</span></td>
        <td><button type="button" class="employee-name-link" title="Klik untuk isi KPI" onclick="openEkpiFormForEmployee(${dataIdx})">${esc(row.nama)}</button></td>
        <td>${esc(row.jabatan)}</td>
        <td style="text-align:center;font-weight:800;color:#2b4fbd">${esc(row.level)}</td>
        <td>${esc(row.divisi)}</td>
        <td>${esc(row.direktorat)}</td>
        <td style="text-align:center"><button type="button" class="btn-kpi-edit" title="Edit KPI secara berkala" onclick="openEkpiFormForEmployee(${dataIdx})">✏️ Edit</button></td>
