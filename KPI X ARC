// ═══ PERIODE KPI HELPERS ═══════════════════════════════
function formatIdDate(iso) {
  if (!iso) return '';
  const parts = String(iso).split('-');
  if (parts.length !== 3) return iso;
  return `${parts[2]}/${parts[1]}/${parts[0]}`;
}
function formatPeriodeRange(rec) {
  const from = formatIdDate(rec && rec.periodeStart);
  const to = formatIdDate(rec && rec.periodeEnd);
  if (from && to) return `${from} – ${to}`;
  if (from) return `Mulai ${from}`;
  if (to) return `Sampai ${to}`;
  return (rec && rec.periode) || '—';
}


function findEkpiRecordIndexByNik(nik) {
  return ekpiRecords.findIndex(r => String(r.nik || '').trim() === String(nik || '').trim());
}

function getKpiPctScore(outcome) {
  const bobot = parseFloat(outcome.bobot) || 0;
  const target = parseFloat(outcome.target) || 0;
  const realisasi = parseFloat(outcome.realisasi) || 0;
  const pol = outcome.pol || 'Higher is better';
  let pct = 0;
  if (pol === 'Must be zero') {
    pct = realisasi === 0 ? 100 : 0;
  } else if (target !== 0) {
    if (pol === 'Higher is better') pct = Math.min((realisasi / target) * 100, 100);
    else if (pol === 'Lower is better') pct = realisasi <= target ? 100 : Math.max(0, (1 - (realisasi - target) / target) * 100);
  }
  return { pct, score: (bobot / 100) * pct };
}

