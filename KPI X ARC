function syncKpiRecordToAllMenus(rec) {
  if (!rec) return;
  let empIdx = findEmployeeIndexFromKpiRecord(rec);
  const score = rec.nilaiAkhir === '' || rec.nilaiAkhir === null || rec.nilaiAkhir === undefined ? null : parseFloat(rec.nilaiAkhir);
  if (empIdx < 0) {
    kpiData.push({
      no: kpiData.length + 1,
      bu: '', nik: rec.nik || '', nama: rec.nama || '', jabatan: rec.jabatan || '',
      level: '', dept: '', divisi: '', direktorat: '',
      jumlah: (rec.outcomes || []).length, periode: rec.periode || '', skor: isNaN(score) ? null : score,
      kpiUploaded: true, kpiUpdatedAt: rec.createdAt || new Date().toISOString()
    });
    empIdx = kpiData.length - 1;
  } else {
    const emp = kpiData[empIdx];
    // Jangan overwrite data master Excel yang sudah ada; hanya lengkapi field kosong dan update info KPI.
    if (!emp.nama && rec.nama) emp.nama = rec.nama;
    if (!emp.nik && rec.nik) emp.nik = rec.nik;
    if (!emp.jabatan && rec.jabatan) emp.jabatan = rec.jabatan;
    emp.jumlah = (rec.outcomes || []).length;
    emp.periode = rec.periode || emp.periode || '';
    emp.skor = isNaN(score) ? null : score;
    emp.kpiUploaded = true;
    emp.kpiUpdatedAt = rec.createdAt || new Date().toISOString();
  }

  if (typeof arcData !== 'undefined') {
    const emp = kpiData[empIdx];
    const nikKey = normalizeNikKey(emp.nik);
    const nameKey = normalizeNameKey(emp.nama);
    let arcIdx = nikKey ? arcData.findIndex(r => normalizeNikKey(r.nik) === nikKey) : -1;
    if (arcIdx < 0 && nameKey) arcIdx = arcData.findIndex(r => normalizeNameKey(r.nama) === nameKey);
    if (arcIdx < 0) {
      arcData.push(makeBlankArcRowFromEmployee(emp));
    } else {
      // Sinkronkan identitas, tetapi pertahankan nilai ARC & details yang sudah ada.
      arcData[arcIdx].nik = arcData[arcIdx].nik || emp.nik || '';
      arcData[arcIdx].nama = emp.nama || arcData[arcIdx].nama || '';
      arcData[arcIdx].jabatan = emp.jabatan || arcData[arcIdx].jabatan || '';
      arcData[arcIdx].level = emp.level || arcData[arcIdx].level || '';
      arcData[arcIdx].dept = emp.dept || arcData[arcIdx].dept || '';
      arcData[arcIdx].divisi = emp.divisi || arcData[arcIdx].divisi || '';
      arcData[arcIdx].direktorat = emp.direktorat || arcData[arcIdx].direktorat || '';
      arcData[arcIdx].bu = emp.bu || arcData[arcIdx].bu || '';
    }
    const arcScore = rec.arcScore === null || rec.arcScore === undefined || rec.arcScore === '' ? null : parseFloat(rec.arcScore);
    if (arcScore !== null && !isNaN(arcScore)) {
      const targetNik = emp.nik || rec.nik || (arcIdx >= 0 ? arcData[arcIdx].nik : '');
      const key = targetNik || (arcIdx >= 0 ? arcData[arcIdx].nik : rec.nama);
      if (!arcEdited[key]) arcEdited[key] = {};
      arcEdited[key].arc_2026_h1 = arcScore;
      const base = arcIdx >= 0 ? arcData[arcIdx] : makeBlankArcRowFromEmployee(emp);
      const vals = [arcScore, base.arc_2025_h2, base.arc_2025_h1, base.arc_2024_h2]
        .map(v => v === null || v === undefined || v === '' ? null : parseFloat(v))
        .filter(v => v !== null && !isNaN(v));
      arcEdited[key].average = vals.length ? parseFloat((vals.reduce((a,b)=>a+b,0)/vals.length).toFixed(2)) : arcScore;
    }
  }
}
