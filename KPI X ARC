function saveMasterEditModal(){
  const idx = parseInt(document.getElementById('masterEditIndex').value, 10);
  const oldEmp = kpiData[idx];
  if(!oldEmp){ showToast('⚠️ Data karyawan tidak ditemukan'); return; }

  const newNik = document.getElementById('masterEditNik').value.trim();
  const newNama = document.getElementById('masterEditNama').value.trim();
  if(!newNik && !newNama){ showToast('⚠️ NIK atau Nama Pegawai wajib diisi'); return; }

  const newNikKey = normalizeNikKey(newNik);
  if(newNikKey && kpiData.some((r,i)=> i !== idx && normalizeNikKey(r.nik) === newNikKey)){
    showToast('⚠️ NIK sudah digunakan oleh karyawan lain');
    return;
  }

  const before = {...oldEmp};
  const updated = {
    ...oldEmp,
    no: document.getElementById('masterEditNo').value.trim(),
    bu: document.getElementById('masterEditBU').value.trim(),
    nik: newNik,
    nama: newNama,
    jabatan: document.getElementById('masterEditJabatan').value.trim(),
    level: document.getElementById('masterEditLevel').value.trim(),
    dept: oldEmp.dept ?? '',
    divisi: document.getElementById('masterEditDivisi').value.trim(),
    direktorat: document.getElementById('masterEditDirektorat').value.trim()
  };
  kpiData[idx] = updated;
  syncEditedMasterEmployee(before, updated);
  closeMasterEditModal();
  if (typeof refreshAllMenusAfterKpiUpdate === 'function') refreshAllMenusAfterKpiUpdate();
  else { initBUFilter(); renderTable(); renderMasterData(); }
  showToast('✅ Master Data karyawan berhasil diperbarui');
}

function resetMasterFilters(){
  ['masterSearchInput','masterFilterBU','masterFilterLevel','masterFilterDirektorat'].forEach(id=>{const el=document.getElementById(id); if(el) el.value='';});
  renderMasterData();
}
function exportMasterDataCSV(){
  const rows=getMasterFiltered();
  let csv='NO,BUSINESS UNIT,NIK,NAMA PEGAWAI,JABATAN,Level,DIVISI,Direktorat\n';
  rows.forEach((r,i)=>{csv += [r.no||i+1,r.bu||'',r.nik||'',r.nama||'',r.jabatan||'',r.level||'',r.dept||'',r.divisi||'',r.direktorat||''].map(csvEsc).join(',')+'\n';});
