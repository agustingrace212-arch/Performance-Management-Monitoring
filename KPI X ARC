function upsertEkpiRecord(rec) {
  const idx = findEkpiRecordIndexByNik(rec.nik);
  if (idx >= 0) ekpiRecords[idx] = rec;
  else ekpiRecords.push(rec);
  syncKpiRecordToAllMenus(rec);
}

async function uploadKPIFile(file) {
  if (!file) return { ok:false, fileName:'', message:'File tidak ditemukan' };
  const parsedFile = await readUploadKPIFile(file);
  const parsed = parseKPIUploadRows(parsedFile.rows || []);
  const rec = buildEkpiRecordFromParsed(parsed);

  if (!cellText(rec.nik) && !cellText(rec.nama)) {
    return { ok:false, fileName:file.name, message:'Nama/NIK tidak terbaca' };
  }
  if (!rec.outcomes.length) {
    return { ok:false, fileName:file.name, message:'Outcomes/KPI tidak ditemukan' };
  }

  upsertEkpiRecord(rec);
  return { ok:true, fileName:file.name, nama:rec.nama, nik:rec.nik };
}

async function uploadKPIFiles(files) {
  const list = Array.from(files || []);
  if (!list.length) return;

  showToast(`⏳ Membaca ${list.length} file KPI...`);
  const success = [];
  const failed = [];

  for (const file of list) {
    try {
      const result = await uploadKPIFile(file);
      if (result.ok) success.push(result);
      else failed.push(result);
    } catch(err) {
      console.error(err);
      failed.push({ ok:false, fileName:file.name, message:(err.message || String(err)) });
    }
  }

  refreshAllMenusAfterKpiUpdate();

  if (success.length && !failed.length) {
    showToast(`✅ ${success.length} file KPI berhasil diupload`);
  } else if (success.length && failed.length) {
    showToast(`✅ ${success.length} berhasil, ⚠️ ${failed.length} gagal dibaca`);
    console.warn('File KPI gagal:', failed);
  } else {
    showToast('⚠️ Semua file KPI gagal dibaca. Cek format Form KPI.');
    console.warn('File KPI gagal:', failed);
  }
}

function handleUploadKPI(input) {
  const files = input.files;
  if (!files || !files.length) return;
  ensureXLSXReady(async () => {
    await uploadKPIFiles(files);
    input.value = '';
  });
}

