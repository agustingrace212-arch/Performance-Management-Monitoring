function readUploadKPIFile(file) {
  return new Promise((resolve, reject) => {
    const ext = (file.name.split('.').pop() || '').toLowerCase();
    const reader = new FileReader();
    reader.onerror = () => reject(new Error('Gagal membaca file ' + file.name));
    if (ext === 'csv') {
      reader.onload = e => {
        const rows = String(e.target.result || '').split(/\r?\n/).filter(l => l.trim()).map(l => l.split(',').map(c => c.trim().replace(/^"|"$/g,'')));
        resolve({ fileName:file.name, rows });
      };
      reader.readAsText(file);
    } else {
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), { type:'array', cellDates:true });
          const ws = wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, { header:1, defval:'', raw:false });
          resolve({ fileName:file.name, rows });
        } catch(err) { reject(err); }
      };
      reader.readAsArrayBuffer(file);
    }
  });
}

function cellText(v) { return String(v ?? '').trim(); }
function normText(v) { return cellText(v).toLowerCase().replace(/\s+/g,' '); }
function isBlankRow(row) { return !row || row.every(c => cellText(c) === ''); }
function parseNum(v) {
  const s = cellText(v).replace(/%/g,'').replace(/,/g,'.').replace(/[^0-9.\-]/g,'');
  if (s === '' || s === '-' || s === '.') return '';
  const n = parseFloat(s);
  return isNaN(n) ? '' : n;
}
function normalizePolarization(v) {
  const s = normText(v);
  if (s.includes('zero') || s.includes('0')) return 'Must be zero';
  if (s.includes('lower') || s.includes('lebih kecil')) return 'Lower is better';
  return 'Higher is better';
}
function nextValueRight(row, col) {
  for (let c = col + 1; c < Math.min(row.length, col + 8); c++) {
    const v = cellText(row[c]);
    if (v && v !== ':') return v;
  }
  return '';
}
function findLabelValue(rows, labels) {
  const normalizedLabels = labels.map(normText);
  for (let r = 0; r < Math.min(rows.length, 40); r++) {
    const row = rows[r] || [];
    for (let c = 0; c < row.length; c++) {
      const txt = normText(row[c]);
      if (normalizedLabels.some(l => txt === l || txt.includes(l))) {
        const right = nextValueRight(row, c);
        if (right) return right;
        for (let rr = r + 1; rr < Math.min(rows.length, r + 4); rr++) {
          const below = cellText((rows[rr] || [])[c]);
          if (below && below !== ':') return below;
        }
      }
    }
  }
  return '';
}
function findMission(rows) {
  let start = rows.findIndex(r => (r || []).some(c => normText(c).includes('ii. mission')));
  let end = rows.findIndex(r => (r || []).some(c => normText(c).includes('iii. outcomes')));
  if (start < 0) return '';
  if (end < 0) end = Math.min(rows.length, start + 8);
  const chunks = [];
  for (let r = start + 1; r < end; r++) {
    (rows[r] || []).forEach(c => {
      const t = cellText(c);
      const nt = normText(t);
      if (!t || t === ':' || nt.includes('mission (misi) adalah') || nt.includes('executive summary')) return;
      chunks.push(t);
    });
  }
  return chunks.join(' ').trim();
}
function findOutcomeHeader(rows) {
  for (let r = 0; r < rows.length; r++) {
    const joined = normText((rows[r] || []).join(' '));
    if (joined.includes('outcome') && joined.includes('bobot') && joined.includes('target')) return r;
  }
  return -1;
}
function findHeaderCol(row, aliases) {
  const lower = (row || []).map(normText);
  for (const alias of aliases) {
    const a = normText(alias);
    const idx = lower.findIndex(v => v.includes(a));
    if (idx >= 0) return idx;
  }
  return -1;
}
function findArcSubHeaderCol(header, subHeader, label, startAfterCol) {
  const wanted = normText(label);
  for (let i = Math.max(0, startAfterCol || 0); i < subHeader.length; i++) {
    if (normText(subHeader[i]) === wanted) return i;
  }
  const arcMainCol = (header || []).findIndex(v => normText(v).includes('skor arc'));
  if (arcMainCol >= 0) {
    const offset = wanted === 'a' ? 0 : wanted === 'r' ? 1 : wanted === 'c' ? 2 : -1;
    if (offset >= 0) return arcMainCol + offset;
  }
  return -1;
}

function parseKPIUploadRows(rows) {
  const data = {
    nama: findLabelValue(rows, ['Nama Karyawan', 'Nama Pegawai']),
    nik: findLabelValue(rows, ['NIK']),
    jabatan: findLabelValue(rows, ['Jabatan']),
    joinDate: findLabelValue(rows, ['Join Date']),
    kebutuhan: findLabelValue(rows, ['Kebutuhan Penilaian']),
    periode: findLabelValue(rows, ['Periode Penilaian']),
    periodeStart: findLabelValue(rows, ['Periode KPI Dari', 'KPI Dari', 'Dari']),
    periodeEnd: findLabelValue(rows, ['Periode KPI Sampai', 'KPI Sampai', 'Sampai']),
    mission: findMission(rows),
    outcomes: []
  };

  const headerIdx = findOutcomeHeader(rows);
  if (headerIdx < 0) return data;
  const header = rows[headerIdx] || [];
  const monthHeader = rows[headerIdx + 1] || [];

  const noCol = findHeaderCol(header, ['No']);
  const outcomeCol = findHeaderCol(header, ['Outcome']);
  const bobotCol = findHeaderCol(header, ['Bobot']);
  const targetCol = findHeaderCol(header, ['Target']);
  const satuanCol = findHeaderCol(header, ['Satuan']);
  const polCol = findHeaderCol(header, ['Polarization', 'Polarisasi']);
  const realisasiCol = findHeaderCol(header, ['Realisasi Akhir']);
  const ketCol = findHeaderCol(header, ['Keterangan', 'Bukti']);
  const arcACol = findArcSubHeaderCol(header, monthHeader, 'A', ketCol >= 0 ? ketCol : realisasiCol);
  const arcRCol = findArcSubHeaderCol(header, monthHeader, 'R', ketCol >= 0 ? ketCol : realisasiCol);
  const arcCCol = findArcSubHeaderCol(header, monthHeader, 'C', ketCol >= 0 ? ketCol : realisasiCol);

  let monthCols = [];
  monthHeader.forEach((v, i) => {
    const n = parseInt(cellText(v), 10);
    if (n >= 1 && n <= 12) monthCols.push({ m:n, c:i });
  });
  if (monthCols.length === 0 && polCol >= 0 && realisasiCol > polCol) {
    for (let c = polCol + 1, m = 1; c < realisasiCol && m <= 12; c++, m++) monthCols.push({ m, c });
  }

  for (let r = headerIdx + 2; r < rows.length; r++) {
    const row = rows[r] || [];
    const first = normText(row[noCol >= 0 ? noCol : 0]);
    if (first.includes('total') || first.includes('nilai akhir') || first.includes('iv. approval')) break;
    if (isBlankRow(row)) continue;
    const rowNum = parseInt(cellText(row[noCol >= 0 ? noCol : 0]), 10);
    const outcome = cellText(row[outcomeCol]);
    const bobot = parseNum(row[bobotCol]);
    const target = parseNum(row[targetCol]);
    const hasContent = outcome || bobot !== '' || target !== '' || monthCols.some(x => cellText(row[x.c])) || cellText(row[realisasiCol]);
    if (!hasContent) continue;
    if (!isNaN(rowNum) || hasContent) {
      const o = {
        outcome,
        bobot: bobot === '' ? 0 : bobot,
        target: target === '' ? 0 : target,
        satuan: cellText(row[satuanCol]) || '%',
        pol: normalizePolarization(row[polCol]),
        realisasi: parseNum(row[realisasiCol]),
        keterangan: cellText(row[ketCol]),
        arcA: parseNum(row[arcACol]),
        arcR: parseNum(row[arcRCol]),
        arcC: parseNum(row[arcCCol])
      };
      monthCols.forEach(x => { o['m' + x.m] = parseNum(row[x.c]); });
      if (o.realisasi === '') {
        for (let m = 12; m >= 1; m--) {
          if (o['m' + m] !== '' && o['m' + m] !== undefined) { o.realisasi = o['m' + m]; break; }
        }
      }
      data.outcomes.push(o);
    }
  }
  return data;
}

