function getMasterFiltered(){
  const q=(document.getElementById('masterSearchInput')?.value||'').toLowerCase();
  const bu=document.getElementById('masterFilterBU')?.value||'';
  const lvl=document.getElementById('masterFilterLevel')?.value||'';
  const dir=document.getElementById('masterFilterDirektorat')?.value||'';
  return kpiData.filter(r=>{
    const text=[r.no,r.bu,r.nik,r.nama,r.jabatan,r.level,r.divisi,r.direktorat].join(' ').toLowerCase();
    return (!q || text.includes(q)) && (!bu || r.bu===bu) && (!lvl || r.level===lvl) && (!dir || r.direktorat===dir);
  });
}
function initMasterFilters(){
  const fill=(id, values)=>{
    const sel=document.getElementById(id); if(!sel) return;
    const selected=sel.value || '';
    const first=sel.options[0]?.textContent || 'Semua';
    sel.innerHTML=`<option value="">${first}</option>`;
    [...new Set(values.map(v=>String(v??'').trim()).filter(Boolean))].sort().forEach(v=>{
      const o=document.createElement('option'); o.value=v; o.textContent=v; sel.appendChild(o);
