// ── FILTER ───────────────────────────────────────────
function getArcFiltered() {
  const qNama  = (document.getElementById('arcFNama')?.value||'').toLowerCase();
  const qJab   = (document.getElementById('arcFJabatan')?.value||'').toLowerCase();
  const qDir   = (document.getElementById('arcFDirektorat')?.value||'').toLowerCase();
  const qBu    = (document.getElementById('arcFBu')?.value||'').toLowerCase();

  return arcData.filter(r => {
    const eff = Object.assign({},r,arcEdited[r.nik]||{});
    const f   = getArcFlag(eff.average);
    if(qNama && !r.nama.toLowerCase().includes(qNama)) return false;
    if(qJab  && !(r.jabatan||'').toLowerCase().includes(qJab)) return false;
    if(qDir  && !(r.direktorat||'').toLowerCase().includes(qDir)) return false;
    if(qBu   && !(r.bu||'').toLowerCase().includes(qBu)) return false;
    if(arcActivePeriod!=='all' && eff[arcActivePeriod]===null) return false;
    return true;
  });
}

// ── RENDER TABLE ─────────────────────────────────────
let arcCurrentPage=1,arcPageSize=25,arcTotalPages=1,arcFiltered=[];

function renderArcTable() {
  arcFiltered=getArcFiltered();
  arcTotalPages=Math.max(1,Math.ceil(arcFiltered.length/arcPageSize));
  if(arcCurrentPage>arcTotalPages) arcCurrentPage=arcTotalPages;
  const start=(arcCurrentPage-1)*arcPageSize;
  const tbody=document.getElementById('arcTableBody');
  tbody.innerHTML='';
  const pageRows=arcFiltered.slice(start,start+arcPageSize);

  if(!pageRows.length) {
    tbody.innerHTML='<tr><td colspan="12" style="text-align:center;padding:40px;color:#9aaac8">Tidak ada data yang cocok dengan filter</td></tr>';
  } else {
    pageRows.forEach((row,i)=>{
      const idx=arcData.indexOf(row);
      const eff=Object.assign({},row,arcEdited[row.nik]||{});
      const f=getArcFlag(eff.average);
      const tr=document.createElement('tr');
      if(arcSelectedNik&&row.nik===arcSelectedNik) tr.style.background='#eef2ff';

      const sc=(val,key)=>{
        if(val===null||val===undefined) return '<span style="color:#94a3b8;font-size:11px">—</span>';
        const c=arcBarColor(val),pct=((val/5)*100).toFixed(0);
        return `<div class="mini-bar-wrap"><div class="mini-bar"><div class="mini-bar-fill" style="width:${pct}%;background:${c}"></div></div><button type="button" class="arc-score-link" style="min-width:26px;color:${c};font-weight:800;font-size:12px" onclick="openArcSummary(${idx},'${key}')">${val}</button></div>`;
      };

      const pdHide=(k)=> arcActivePeriod!=='all'&&arcActivePeriod!==k?'style="display:none"':'';
      const fs='';

      tr.innerHTML=`
        <td style="color:#9aaac8;font-weight:600">${start+i+1}</td>
        <td><strong>${eff.nama}</strong><br><span style="font-size:11px;color:#94a3b8">${eff.nik}</span></td>
        <td class="arc-col-jabatan" style="font-size:11.5px;color:#475569;max-width:160px">${eff.jabatan||'—'}</td>
        <td class="arc-col-direktorat"><span style="font-size:11px;background:#eef2ff;color:#2b4fbd;border-radius:5px;padding:2px 8px;font-weight:600">${eff.direktorat||'—'}</span></td>
        <td class="arc-col-bu" style="font-size:11px;color:#64748b">${eff.bu||'—'}</td>
        <td class="arc-col-period arc-col-arc_2026_h1" style="text-align:center" ${pdHide('arc_2026_h1')}>${sc(eff.arc_2026_h1,'arc_2026_h1')}</td>
        <td class="arc-col-period arc-col-arc_2025_h2" style="text-align:center" ${pdHide('arc_2025_h2')}>${sc(eff.arc_2025_h2,'arc_2025_h2')}</td>
        <td class="arc-col-period arc-col-arc_2025_h1" style="text-align:center" ${pdHide('arc_2025_h1')}>${sc(eff.arc_2025_h1,'arc_2025_h1')}</td>
        <td class="arc-col-period arc-col-arc_2024_h2" style="text-align:center" ${pdHide('arc_2024_h2')}>${sc(eff.arc_2024_h2,'arc_2024_h2')}</td>
        <td style="text-align:center">${eff.average!==null
          ?`<div class="mini-bar-wrap"><div class="mini-bar"><div class="mini-bar-fill" style="width:${((eff.average/5)*100).toFixed(0)}%;background:${arcBarColor(eff.average)}"></div></div><button type="button" class="arc-score-link" style="min-width:26px;color:${arcBarColor(eff.average)};font-weight:900" onclick="openArcSummary(${idx},'average')">${eff.average}</button></div>`
          :'<span style="color:#94a3b8;font-size:11px">—</span>'}</td>
