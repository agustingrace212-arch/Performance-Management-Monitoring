// ═══ COLLECT eKPI FORM DATA ══════════════════════════════
function collectEkpiForm() {
  const outcomes = [];
  document.getElementById('outcomeBody').querySelectorAll('tr').forEach(tr => {
    const inputs = tr.querySelectorAll('input,select');
    const o = {
      outcome:    tr.querySelectorAll('input')[0].value,
      bobot:      parseFloat(tr.querySelector('.outcome-bobot').value) || 0,
      target:     parseFloat(tr.querySelector('.outcome-target').value) || 0,
      satuan:     tr.querySelector('.outcome-satuan').value,
      pol:        tr.querySelector('.outcome-pol').value,
      realisasi:  parseFloat(tr.querySelector('.outcome-realisasi').value) || 0,
      keterangan: (tr.querySelector('.outcome-keterangan')?.value || ''),
      arcA:       tr.querySelector('.outcome-arc-a')?.value === '' ? '' : parseFloat(tr.querySelector('.outcome-arc-a')?.value),
      arcR:       tr.querySelector('.outcome-arc-r')?.value === '' ? '' : parseFloat(tr.querySelector('.outcome-arc-r')?.value),
      arcC:       tr.querySelector('.outcome-arc-c')?.value === '' ? '' : parseFloat(tr.querySelector('.outcome-arc-c')?.value),
    };
    KPI_MONTHS.forEach((m,i) => {
      const el = tr.querySelectorAll('.outcome-progress')[i];
      o['m'+m] = el ? parseFloat(el.value)||'' : '';
    });
    if (o.outcome || o.bobot) outcomes.push(o);
  });

  const nilaiAkhir = [...document.querySelectorAll('.outcome-score')]
    .reduce((s,el)=>s+(parseFloat(el.value)||0),0);

  return {
    nama:      document.getElementById('fNama').value.trim(),
    nik:       document.getElementById('fNik').value.trim(),
    jabatan:   document.getElementById('fJabatan').value.trim(),
    joinDate:  document.getElementById('fJoinDate').value,
    kebutuhan: document.getElementById('fKebutuhan').value,
    periode:   document.getElementById('fPeriode').value,
    periodeStart: document.getElementById('fPeriodeStart').value,
    periodeEnd:   document.getElementById('fPeriodeEnd').value,
    mission:   document.getElementById('fMission').value.trim(),
    outcomes,
    nilaiAkhir: nilaiAkhir.toFixed(1),
    arcScore: calcArcFromKpiInputs(),
    createdAt: new Date().toISOString(),
  };
}

