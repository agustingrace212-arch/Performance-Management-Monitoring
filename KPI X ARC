let acActiveIdx = -1;

function acSearch(inputId, dropId, field) {
  const q    = document.getElementById(inputId).value.trim().toLowerCase();
  const drop = document.getElementById(dropId);
  acActiveIdx = -1;

  if (q.length < 1) { drop.innerHTML=''; drop.classList.remove('open'); return; }

  const matches = kpiData.filter(r => {
    if (field === 'nama') return r.nama.toLowerCase().includes(q);
    if (field === 'nik')  return r.nik.toLowerCase().includes(q) || r.nama.toLowerCase().includes(q);
    return false;
  }).slice(0, 12);

  if (matches.length === 0) { drop.innerHTML=''; drop.classList.remove('open'); return; }

  drop.innerHTML = matches.map((r, i) => `
    <div class="ac-item" data-idx="${i}" onmousedown="acSelect('${dropId}', ${kpiData.indexOf(r)})">
      <div class="ac-item-name">${r.nama}</div>
      <div class="ac-item-sub">${r.nik} &nbsp;·&nbsp; ${r.jabatan} &nbsp;·&nbsp; ${r.bu}</div>
    </div>`).join('');
  drop.classList.add('open');
}

function acSelect(dropId, kpiIdx) {
  const r = kpiData[kpiIdx];
  document.getElementById('fNama').value    = r.nama;
  document.getElementById('fNik').value     = r.nik;
  document.getElementById('fJabatan').value = r.jabatan;
