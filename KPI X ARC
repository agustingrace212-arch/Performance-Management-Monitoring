let arcEdited = {};
let arcSelectedNik = null;

// active search column pill
let arcSearchCol = 'all';
// active period filter ('all' or a key)
let arcActivePeriod = 'all';

// ── FLAG / COLOR ─────────────────────────────────────
function getArcFlag(avg) {
  if (avg===null||avg===undefined) return {cls:'nodata',label:'Belum Lengkap'};
  if (avg>4.5) return {cls:'green', label:'Green'};
  if (avg>=3.5) return {cls:'yellow',label:'Yellow'};
  if (avg>=2.0) return {cls:'orange',label:'Orange'};
  return {cls:'red',label:'Red'};
}
function arcBarColor(v) {
  if (v===null) return '#cbd5e1';
  if (v>4.5) return '#16a34a';
  if (v>=3.5) return '#d97706';
  if (v>=2.0) return '#f97316';
  return '#dc2626';
}
function arcPredikat(v) {
  if (v===null) return '';
  if (v>4.5) return 'Green';
  if (v>=3.5) return 'Yellow';
  if (v>=2.0) return 'Orange';
  return 'Red';
}

// ── COLUMN PILL TOGGLE ───────────────────────────────
function arcTogglePill(btn, col) {
  document.querySelectorAll('.arc-col-pill').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  arcSearchCol = col;
  const inp = document.getElementById('arcSearchMain');
  if (inp.value.trim()) arcAcSearch('arcSearchMain','arcDropMain');
}

// ── PERIOD TOGGLE ────────────────────────────────────
const ARC_PERIODS = ['arc_2026_h1','arc_2025_h2','arc_2025_h1','arc_2024_h2'];
function arcTogglePeriod(btn, key) {
  document.querySelectorAll('.arc-period-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  arcActivePeriod = key;

  // Show/hide columns in table
  ARC_PERIODS.forEach(p => {
    document.querySelectorAll('.arc-col-'+p).forEach(el => {
      el.style.display = (key==='all'||key===p) ? '' : 'none';
    });
  });

  // Also filter table if period selected
  arcGoPage(1);
}

// ── AUTOCOMPLETE ─────────────────────────────────────
let arcAcActiveIdx = -1;

function arcAcSearch(inputId, dropId) {
  const q    = document.getElementById(inputId).value.trim().toLowerCase();
  const drop = document.getElementById(dropId);
  arcAcActiveIdx = -1;
  if (q.length < 1) { drop.innerHTML=''; drop.classList.remove('open'); return; }

  const col = arcSearchCol;
  const matches = arcData.filter(r => {
    const eff = Object.assign({},r,arcEdited[r.nik]||{});
    if (col==='nama')        return r.nama.toLowerCase().includes(q);
    if (col==='nik')         return r.nik.toLowerCase().includes(q)||r.nama.toLowerCase().includes(q);
    if (col==='jabatan')     return (r.jabatan||'').toLowerCase().includes(q);
    if (col==='direktorat')  return (r.direktorat||'').toLowerCase().includes(q);
    if (col==='bu')          return (r.bu||'').toLowerCase().includes(q);
    // default: search all
    return r.nama.toLowerCase().includes(q)||r.nik.toLowerCase().includes(q)||
           (r.jabatan||'').toLowerCase().includes(q)||(r.direktorat||'').toLowerCase().includes(q)||(r.bu||'').toLowerCase().includes(q);
  }).slice(0,15);

  if (!matches.length) {
    drop.innerHTML='<div class="ac-item" style="color:#94a3b8;cursor:default;font-size:12px">Tidak ada hasil</div>';
    drop.classList.add('open'); return;
  }

  drop.innerHTML = matches.map(r => {
    const eff = Object.assign({},r,arcEdited[r.nik]||{});
    const avgLabel = eff.average!==null
      ? `<span style="font-weight:700;color:${arcBarColor(eff.average)};margin-left:6px">${eff.average}</span>` : '';
    return `<div class="ac-item" onmousedown="arcAcSelect(${arcData.indexOf(r)})">
      <div class="ac-item-name">${r.nama}${avgLabel}</div>
      <div class="ac-item-sub">${r.nik} &nbsp;·&nbsp; ${r.jabatan||'—'} &nbsp;·&nbsp; ${r.direktorat||''}</div>
    </div>`;
  }).join('');
  drop.classList.add('open');
}

function arcAcSelect(idx) {
  const r = arcData[idx];
  document.getElementById('arcSearchMain').value = r.nama;
  document.getElementById('arcDropMain')?.classList.remove('open');
  arcShowSelectedCard(idx);
}
function arcAcClose(dropId) {
  setTimeout(()=>{ const el=document.getElementById(dropId); if(el)el.classList.remove('open'); },180);
}
function arcAcKeyNav(e, dropId) {
  const drop=document.getElementById(dropId);
  const items=drop.querySelectorAll('.ac-item[onmousedown]');
  if(!items.length) return;
  if(e.key==='ArrowDown'){e.preventDefault();arcAcActiveIdx=Math.min(arcAcActiveIdx+1,items.length-1);}
  else if(e.key==='ArrowUp'){e.preventDefault();arcAcActiveIdx=Math.max(arcAcActiveIdx-1,0);}
  else if(e.key==='Enter'&&arcAcActiveIdx>=0){e.preventDefault();items[arcAcActiveIdx].dispatchEvent(new MouseEvent('mousedown'));return;}
  else if(e.key==='Escape'){drop.classList.remove('open');return;}
  items.forEach((el,i)=>el.classList.toggle('active',i===arcAcActiveIdx));
  if(arcAcActiveIdx>=0)items[arcAcActiveIdx].scrollIntoView({block:'nearest'});
}

