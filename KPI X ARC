<!-- TOPBAR -->
<header class="topbar">
  <div class="brand">
    <div class="brand-logo">CIMORY<br>GROUP</div>
    <div class="brand-text">
      <strong>Performance Management</strong>
      <span>Cimory Group</span>
    </div>
  </div>
  <nav class="nav">
    <button class="nav-item active" onclick="showPage('kpi')" id="tab-kpi">
      <span>📋</span> Input KPI
    </button>
    <button class="nav-item" onclick="showPage('arc')" id="tab-arc">
      <span>🎯</span> Input ARC Appraisal
    </button>
    <button class="nav-item" onclick="showPage('rekap')" id="tab-rekap">
      <span>📈</span> Rekap
    </button>
    <button class="nav-item" onclick="showPage('output')" id="tab-output">
      <span>📊</span> Output
    </button>
    <button class="nav-item" onclick="showPage('masterdata')" id="tab-masterdata">
      <span>🗃️</span> Master Data
    </button>
  </nav>
  <div class="topbar-right">Total Karyawan: <strong id="totalCount">221</strong></div>
</header>

<!-- PAGE: INPUT KPI -->
<div class="page visible" id="page-kpi">

  <!-- Sub-tab bar + KPI action buttons -->
  <div class="card" style="margin-bottom:0;border-radius:14px 14px 0 0;overflow:visible">
    <div class="kpi-subtab-head">
      <div class="subtab-bar">
        <button class="subtab-btn active" id="stab-list" onclick="switchSubTab('list')">📋 Data KPI Karyawan</button>
        <button class="subtab-btn" id="stab-form" onclick="switchSubTab('form')" style="display:none">📝 Formulir eKPI (Project)</button>
      </div>
      <div class="kpi-top-actions">
        <button class="btn-download-kpi" onclick="downloadFormKPI()">⬇️ Download Form KPI</button>
        <button class="btn-merge-kpi" onclick="triggerUploadKPI()">🧩 Upload KPI</button>
        <span class="merge-help">Upload satu atau banyak file Form KPI yang sudah diisi, lalu data otomatis masuk ke kolom Outcomes/KPI.</span>
        <input type="file" id="uploadKpiInput" accept=".xlsx,.xls,.csv" multiple style="display:none" onchange="handleUploadKPI(this)"/>
      </div>
    </div>
  </div>

  <!-- ═══ SUB-TAB: DATA LIST ═══ -->
  <div class="subtab-content visible" id="sub-list" style="background:#f0f2f7">

    <!-- Import Card - hidden per request -->
    <div class="card" style="display:none;border-radius:0 0 0 0;margin-bottom:0;border-top:none">
      <div class="card-header"><span>⬆️</span><h2>Import / Update Data Karyawan via Excel</h2></div>
      <div class="card-body">
        <div class="import-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
          <div class="upload-icon">📂</div>
          <p><strong>Klik atau seret file Excel ke sini</strong><br>
          Format: <strong>.xlsx, .xls, .csv</strong> — Data karyawan akan otomatis muncul di tabel di bawah<br>
          <span style="font-size:12px;color:#94a3b8">Kolom mengikuti file Excel: NO, BUSINESS UNIT, NIK, NAMA PEGAWAI, JABATAN, Level, DIVISI, Direktorat</span></p>
        </div>
        <input type="file" id="fileInput" accept=".xlsx,.xls,.csv" onchange="handleFileUpload(this)"/>
        <div class="import-row">
          <button class="btn-import" onclick="document.getElementById('fileInput').click()">📂 Pilih File</button>
          <button class="btn-template" onclick="downloadTemplate()">⬇️ Unduh Template</button>
          <span class="import-hint">Gunakan NIK sebagai kunci pencocokan data · File .xlsx otomatis dibaca dan data langsung tampil di tabel</span>
        </div>
        <div id="importStatus" style="display:none;margin-top:12px;padding:10px 16px;border-radius:8px;font-size:13px;font-weight:600;background:#d1fae5;color:#065f46;border:1.5px solid #6ee7b7"></div>
      </div>
    </div>

    <!-- Summary chips -->
    <div style="padding:20px 0 0;background:#f0f2f7">
      <div class="summary-row" style="padding:0 0 0 0">
        <div class="chip total"><div><div class="chip-val" id="chipTotal">221</div><div class="chip-lbl">Total Data Excel</div></div></div>
        <div class="chip green"><div><div class="chip-val" id="chipGreen">0</div><div class="chip-lbl">Business Unit</div></div></div>
        <div class="chip yellow"><div><div class="chip-val" id="chipYellow">0</div><div class="chip-lbl">Level</div></div></div>
        <div class="chip red"><div><div class="chip-val" id="chipRed">0</div><div class="chip-lbl">Direktorat</div></div></div>
        <div class="chip nodata"><div><div class="chip-val" id="chipNoData">0</div><div class="chip-lbl">Divisi</div></div></div>
      </div>
    </div>

    <!-- Table Card -->
    <div class="card" style="margin-top:0">
      <div class="card-header"><span>📋</span><h2>Data KPI Karyawan</h2></div>
      <div class="card-body" style="padding-bottom:0">
        <div class="filter-bar">
          <input type="text" id="searchInput" placeholder="🔍 Cari nama / NIK / jabatan / divisi…" oninput="goPage(1)" style="width:280px">
          <select id="filterBU" onchange="goPage(1)">
            <option value="">Semua Business Unit</option>
          </select>
          <select id="filterPeriod" onchange="goPage(1)">
            <option value="">Semua Level</option>
          </select>
          <select id="filterFlag" onchange="goPage(1)">
            <option value="">Semua Direktorat</option>
          </select>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th style="width:52px">NO</th>
                <th style="min-width:220px">BUSINESS UNIT</th>
                <th style="min-width:95px">NIK</th>
                <th style="min-width:210px">NAMA PEGAWAI</th>
                <th style="min-width:260px">JABATAN</th>
                <th style="width:80px;text-align:center">Level</th>
                <th style="min-width:170px">DIVISI</th>
                <th style="min-width:130px">Direktorat</th>
                <th style="width:95px;text-align:center">Edit KPI</th>
                <th style="width:105px;text-align:center">Preview KPI</th>
              </tr>
            </thead>
            <tbody id="kpiTableBody"></tbody>
          </table>
        </div>
      </div>
      <!-- Pagination -->
      <div class="pager">
        <span class="pager-info" id="pagerInfo"></span>
        <button class="pager-btn" id="btnFirst" onclick="goPage(1)">«</button>
        <button class="pager-btn" id="btnPrev" onclick="goPage(currentPage-1)">‹</button>
        <span id="pageButtons"></span>
        <button class="pager-btn" id="btnNext" onclick="goPage(currentPage+1)">›</button>
        <button class="pager-btn" id="btnLast" onclick="goPage(totalPages)">»</button>
        <select id="pageSizeSelect" onchange="changePageSize()" style="border:1.5px solid #d0d9ef;border-radius:7px;padding:5px 8px;font-size:12px;cursor:pointer">
          <option value="25">25/hal</option>
          <option value="50">50/hal</option>
          <option value="100">100/hal</option>
        </select>
      </div>
      <!-- Action bar -->
      <div class="action-bar">
        <button class="btn-clear" onclick="resetKpiFilters()">🔄 Reset Filter</button>
        <button class="btn-export" onclick="exportCSV()">📤 Ekspor Data Excel</button>
      </div>
    </div>
  </div><!-- /sub-list -->

  <!-- ═══ SUB-TAB: eKPI FORM ═══ -->
  <div class="subtab-content" id="sub-form" style="background:#f0f2f7;padding-top:4px">

    <!-- eKPI Saved List dihapus: form langsung terbuka dari klik nama karyawan -->
    <div id="ekpiListWrap" style="display:none"></div>

    <!-- eKPI Form Panel -->
    <div id="ekpiFormPanel" style="display:none">
      <div class="card">
        <div class="card-header" style="justify-content:space-between">
          <div style="display:flex;align-items:center;gap:10px"><span>📝</span><h2 id="ekpiFormTitle">Formulir eKPI Baru</h2></div>
          <button onclick="closeEkpiForm()" style="background:#f0f2f7;border:none;border-radius:8px;padding:7px 16px;font-size:13px;font-weight:600;cursor:pointer;color:#4a6090">✕ Tutup</button>
        </div>
        <div class="ekpi-form">

          <!-- I. IDENTITAS -->
          <div class="form-section">
            <div class="form-section-title">I. Identitas Karyawan</div>
            <div class="form-grid">
              <div class="form-field">
                <label>Nama Karyawan</label>
                <div class="ac-wrap">
                  <input type="text" id="fNama" placeholder="Ketik nama karyawan…" autocomplete="off"
                    oninput="acSearch('fNama','acNama','nama')" onkeydown="acKeyNav(event,'acNama')" onblur="acClose('acNama')"/>
                  <div class="ac-dropdown" id="acNama"></div>
                </div>
              </div>
              <div class="form-field">
                <label>NIK</label>
                <div class="ac-wrap">
                  <input type="text" id="fNik" placeholder="Ketik NIK karyawan…" autocomplete="off"
                    oninput="acSearch('fNik','acNik','nik')" onkeydown="acKeyNav(event,'acNik')" onblur="acClose('acNik')"/>
                  <div class="ac-dropdown" id="acNik"></div>
                </div>
              </div>
              <div class="form-field">
