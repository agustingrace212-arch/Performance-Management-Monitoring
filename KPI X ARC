function arcEsc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function arcScoreLabel(v){return v===null||v===undefined?'—':Number(v).toFixed(2).replace(/\.00$/,'');}
function arcSummaryCopy(score){
  if(score===null||score===undefined) return {
    strength:'Data ARC untuk periode ini belum tersedia.',
    weakness:'Belum ada nilai yang dapat dianalisis.',
    opportunity:'Lengkapi nilai ARC agar summary dapat terbaca lebih utuh.'
