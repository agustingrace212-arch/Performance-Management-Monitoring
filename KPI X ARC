  document.getElementById('arcChipOrange').textContent =all.filter(r=>r.average!==null&&r.average>=2.0&&r.average<3.5).length;
  document.getElementById('arcChipRed').textContent    =all.filter(r=>r.average!==null&&r.average<2.0).length;
