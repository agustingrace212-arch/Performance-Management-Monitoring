function syncEditedMasterEmployee(oldEmp, newEmp){
  const oldNikKey = normalizeNikKey(oldEmp && oldEmp.nik);
  const newNikKey = normalizeNikKey(newEmp && newEmp.nik);
  const oldNameKey = normalizeNameKey(oldEmp && oldEmp.nama);
  const newNameKey = normalizeNameKey(newEmp && newEmp.nama);

  if (typeof arcData !== 'undefined') {
    let arcIdx = oldNikKey ? arcData.findIndex(r => normalizeNikKey(r.nik) === oldNikKey) : -1;
    if (arcIdx < 0 && newNikKey) arcIdx = arcData.findIndex(r => normalizeNikKey(r.nik) === newNikKey);
    if (arcIdx < 0 && oldNameKey) arcIdx = arcData.findIndex(r => normalizeNameKey(r.nama) === oldNameKey);
    if (arcIdx < 0 && newNameKey) arcIdx = arcData.findIndex(r => normalizeNameKey(r.nama) === newNameKey);
    if (arcIdx < 0) {
      arcData.push(makeBlankArcRowFromEmployee(newEmp));
    } else {
      arcData[arcIdx].nik = newEmp.nik || '';
      arcData[arcIdx].nama = newEmp.nama || '';
      arcData[arcIdx].jabatan = newEmp.jabatan || '';
      arcData[arcIdx].level = newEmp.level || '';
      arcData[arcIdx].dept = newEmp.dept || '';
      arcData[arcIdx].divisi = newEmp.divisi || '';
      arcData[arcIdx].direktorat = newEmp.direktorat || '';
      arcData[arcIdx].bu = newEmp.bu || '';
    }
  }

  if (typeof ekpiRecords !== 'undefined') {
    let recIdx = oldNikKey ? ekpiRecords.findIndex(r => normalizeNikKey(r.nik) === oldNikKey) : -1;
    if (recIdx < 0 && newNikKey) recIdx = ekpiRecords.findIndex(r => normalizeNikKey(r.nik) === newNikKey);
