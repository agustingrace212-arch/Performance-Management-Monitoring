function processSheetData(rows) {
  if (!rows || rows.length < 2) { showImportStatus('⚠️ File kosong atau tidak ada data.', true); return; }
  const headers = rows[0].map(h => String(h||'').toLowerCase().trim());
  const col = name => headers.findIndex(h => h === name.toLowerCase() || h.includes(name.toLowerCase()));
  const noCol = col('no');
  const buCol = col('business unit');
  const nikCol = col('nik');
  const namaCol = headers.findIndex(h => h.includes('nama pegawai') || h === 'nama' || h.includes('nama karyawan'));
  const jabCol = col('jabatan');
  const levelCol = col('level');
  const deptCol = col('departemen');
  const divCol = col('divisi');
  const dirCol = col('direktorat');
  if (nikCol < 0 || namaCol < 0) { showImportStatus('⚠️ Kolom NIK dan NAMA PEGAWAI wajib ada di file Excel.', true); return; }

  kpiData = rows.slice(1).filter(cols => cols && cols.some(c => String(c||'').trim() !== '')).map((cols, i) => ({
    no: noCol >= 0 ? (cols[noCol] ?? '') : i + 1,
    bu: buCol >= 0 ? (cols[buCol] ?? '') : '',
    nik: nikCol >= 0 ? (cols[nikCol] ?? '') : '',
    nama: namaCol >= 0 ? (cols[namaCol] ?? '') : '',
    jabatan: jabCol >= 0 ? (cols[jabCol] ?? '') : '',
    level: levelCol >= 0 ? (cols[levelCol] ?? '') : '',
    dept: deptCol >= 0 ? (cols[deptCol] ?? '') : '',
    divisi: divCol >= 0 ? (cols[divCol] ?? '') : '',
    direktorat: dirCol >= 0 ? (cols[dirCol] ?? '') : ''
  }));
  currentPage = 1;
  initBUFilter();
  initMasterFilters();
  renderTable();
  renderMasterData();
  showImportStatus(`✅ ${kpiData.length} data karyawan berhasil dimuat dari file Excel`, false);
  showToast(`✅ ${kpiData.length} data karyawan berhasil dimuat`);
}

function handleFileUpload(input) {
  const file = input.files[0]; if (!file) return;
  const ext = file.name.split('.').pop().toLowerCase();

  if (ext === 'csv') {
    const reader = new FileReader();
    reader.onload = e => {
      const lines = e.target.result.split('\n').filter(l => l.trim());
      const rows = lines.map(l => l.split(',').map(c => c.trim().replace(/^"|"$/g, '')));
      processSheetData(rows);
    };
    reader.readAsText(file);
  } else if (ext === 'xlsx' || ext === 'xls') {
    // Load SheetJS if not already loaded
    if (typeof XLSX === 'undefined') {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
      script.onload = () => readXLSX(file);
      script.onerror = () => showImportStatus('⚠️ Gagal memuat library xlsx. Coba gunakan format CSV.', true);
      document.head.appendChild(script);
    } else {
      readXLSX(file);
    }
  } else {
    showImportStatus('⚠️ Format file tidak didukung. Gunakan .xlsx, .xls, atau .csv', true);
  }
  input.value = '';
}

function readXLSX(file) {
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = new Uint8Array(e.target.result);
      const wb = XLSX.read(data, { type: 'array' });
      const ws = wb.Sheets[wb.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });
      processSheetData(rows);
    } catch(err) {
      showImportStatus('⚠️ Gagal membaca file Excel: ' + err.message, true);
    }
  };
  reader.readAsArrayBuffer(file);
}

