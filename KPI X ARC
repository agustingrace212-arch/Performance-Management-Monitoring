function getKpiScoreFromRecord(rec){
  if(!rec) return null;
  if(rec.nilaiAkhir!==undefined && rec.nilaiAkhir!==null && rec.nilaiAkhir!=='' && !isNaN(parseFloat(rec.nilaiAkhir))) return parseFloat(rec.nilaiAkhir);
  const outcomes = Array.isArray(rec.outcomes) ? rec.outcomes : [];
  if(!outcomes.length) return null;
  const score = outcomes.reduce((s,o)=>s+(getKpiPctScore(o).score||0),0);
  return isNaN(score) ? null : parseFloat(score.toFixed(2));
}
function getArcLevel(avg){
  if(avg===null || avg===undefined || isNaN(parseFloat(avg))) return null;
  const v=parseFloat(avg);
  if(v>4.5) return 4;
  if(v>=3.5) return 3;
  if(v>=2.0) return 2;
  return 1;
}
function getKpiLevel(score){
  if(score===null || score===undefined || isNaN(parseFloat(score))) return null;
  const v=parseFloat(score);
  if(v>95) return 4;
  if(v>=85) return 3;
  if(v>=70) return 2;
  return 1;
}
function getRekapCategory(arcLevel,kpiLevel){
  return REKAP_MATRIX_MAP[`${arcLevel}-${kpiLevel}`] || 'standard';
}
function getCombinedRekapRows(){
  const kpiByNik = new Map(ekpiRecords.map(r=>[String(r.nik||'').trim(), r]));
  const arcByNik = new Map(arcData.map(r=>[String(r.nik||'').trim(), r]));
  // Rekap menggunakan Master Data/KPI sebagai data utama, sehingga jumlah karyawan
  // di Rekap selalu sama dengan Data KPI Karyawan, ARC Appraisal, dan Master Data.
  // Untuk matriks Output, skor ARC kategorisasi menggunakan gabungan:
  // (0.5 × Skor ARC dari Input KPI) + (0.5 × Average ARC Appraisal 2026 H-1 s.d. 2024 H-2).
  return kpiData.map(emp=>{
    const nik=String(emp.nik||'').trim();
    const arcBase=arcByNik.get(nik) || {};
    const arcEff=Object.assign({}, arcBase, arcEdited[nik]||{});
    const kpiRec=kpiByNik.get(nik);
    const arcHistoricalAvg = arcEff && arcEff.average!==null && arcEff.average!==undefined && !isNaN(parseFloat(arcEff.average)) ? parseFloat(arcEff.average) : null;
    const arcInputKpiAvg = kpiRec && Array.isArray(kpiRec.outcomes) ? calcWeightedArcFromOutcomes(kpiRec.outcomes) : null;
    let arcAvg = null;
    if (arcInputKpiAvg!==null && arcHistoricalAvg!==null) arcAvg = parseFloat(((0.5 * arcInputKpiAvg) + (0.5 * arcHistoricalAvg)).toFixed(2));
    else if (arcInputKpiAvg!==null) arcAvg = arcInputKpiAvg;
    else if (arcHistoricalAvg!==null) arcAvg = arcHistoricalAvg;
    const kpiScore=getKpiScoreFromRecord(kpiRec);
    const arcLevel=getArcLevel(arcAvg);
    const kpiLevel=getKpiLevel(kpiScore);
    const complete = arcLevel!==null && kpiLevel!==null;
    const category = complete ? getRekapCategory(arcLevel,kpiLevel) : null;
    return Object.assign({}, arcEff, emp, {nik, nama:emp.nama||arcEff.nama, jabatan:emp.jabatan||arcEff.jabatan, arcAvg, arcInputKpiAvg, arcHistoricalAvg, kpiScore, arcLevel, kpiLevel, category, complete});
  });
}
