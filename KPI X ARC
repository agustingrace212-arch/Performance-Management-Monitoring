function calcArcRow(inputEl) {
  return calcArcFromKpiInputs();
}

function averageFromOutcomeSelector(selector) {
  const vals = [...document.querySelectorAll(selector)]
    .map(el => el.value.trim() === '' ? null : parseFloat(el.value))
    .filter(v => v !== null && !isNaN(v));
  return vals.length ? parseFloat((vals.reduce((a,b)=>a+b,0) / vals.length).toFixed(2)) : null;
}

function calcWeightedArcScore(avgA, avgR, avgC) {
  if (avgA === null || avgR === null || avgC === null) return null;
  return parseFloat(((0.25 * avgA) + (0.50 * avgR) + (0.25 * avgC)).toFixed(2));
}

function calcWeightedArcFromOutcomes(outcomes) {
  const avg = key => {
    const vals = (outcomes || [])
      .map(o => parseFloat(o[key]))
      .filter(v => !isNaN(v));
    return vals.length ? parseFloat((vals.reduce((a,b)=>a+b,0) / vals.length).toFixed(2)) : null;
  };
  return calcWeightedArcScore(avg('arcA'), avg('arcR'), avg('arcC'));
}

function calcArcFromKpiInputs() {
  const avgA = averageFromOutcomeSelector('.outcome-arc-a');
  const avgR = averageFromOutcomeSelector('.outcome-arc-r');
  const avgC = averageFromOutcomeSelector('.outcome-arc-c');
  const weighted = calcWeightedArcScore(avgA, avgR, avgC);
  const setText = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val === null ? '—' : val; };
  setText('arcAvgA', avgA);
  setText('arcAvgR', avgR);
  setText('arcAvgC', avgC);
  setText('arcWeightedAverage', weighted);
  return weighted;
}

function calcRow(inputEl) {
  const tr = inputEl.closest('tr');
  const bobot     = parseFloat(tr.querySelector('.outcome-bobot').value)  || 0;
  const target    = parseFloat(tr.querySelector('.outcome-target').value)  || 0;
  const realisasi = parseFloat(tr.querySelector('.outcome-realisasi').value) || 0;
  const pol       = tr.querySelector('.outcome-pol').value;
  let pct = 0;
  if (pol === 'Must be zero') {
    pct = realisasi === 0 ? 100 : 0;
  } else if (target !== 0) {
    if (pol === 'Higher is better') pct = Math.min((realisasi / target) * 100, 100);
    else if (pol === 'Lower is better') pct = realisasi <= target ? 100 : Math.max(0, (1 - (realisasi - target)/target) * 100);
  }
  const score = (bobot / 100) * pct;
  tr.querySelector('.outcome-pct').value   = pct.toFixed(1);
  tr.querySelector('.outcome-score').value = score.toFixed(2);
  updateNilaiAkhir();
}

function updateBobot() {
  const total = [...document.querySelectorAll('.outcome-bobot')]
    .reduce((s, el) => s + (parseFloat(el.value)||0), 0);
  const el = document.getElementById('totalBobot');
  el.textContent = total + '%';
  el.style.color = total === 100 ? '#16a34a' : '#dc2626';
  document.getElementById('bobotWarn').style.display = total !== 100 && total > 0 ? 'inline' : 'none';
  document.getElementById('bobotOk').style.display   = total === 100 ? 'inline' : 'none';
}

function updateNilaiAkhir() {
  const total = [...document.querySelectorAll('.outcome-score')]
    .reduce((s, el) => s + (parseFloat(el.value)||0), 0);
  const badge = document.getElementById('nilaiAkhirBadge');
  const pct   = total.toFixed(2).replace('.', ',');
  if ([...document.querySelectorAll('.outcome-bobot')].every(e => !e.value)) {
    badge.className = 'nilai-badge nodata'; badge.textContent = '0,00'; return;
  }
  if (total >= 80)      { badge.className = 'nilai-badge green';  badge.textContent = pct; }
  else if (total >= 60) { badge.className = 'nilai-badge yellow'; badge.textContent = pct; }
  else                  { badge.className = 'nilai-badge red';    badge.textContent = pct; }
}

function clearOutcomeRows() {
  document.getElementById('outcomeBody').innerHTML = '';
  outcomeRowCount = 0;
