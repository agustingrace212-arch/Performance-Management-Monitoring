<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Performance Management – Cimory Group</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',Arial,sans-serif;background:#f0f2f7;color:#1e2a4a;min-height:100vh}

/* ── Topbar ── */
.topbar{background:linear-gradient(90deg,#1e3a8a 0%,#2b4fbd 100%);display:flex;align-items:center;padding:0 24px;height:62px;box-shadow:0 2px 10px rgba(30,58,138,.35);position:sticky;top:0;z-index:100}
.brand{display:flex;align-items:center;gap:10px;min-width:220px}
.brand-logo{width:42px;height:42px;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:10px;color:#1e3a8a;letter-spacing:-.5px;border:2px solid rgba(255,255,255,.3);text-align:center;line-height:1.2}
.brand-text{color:#fff}
.brand-text strong{display:block;font-size:14px;font-weight:700}
.brand-text span{font-size:11px;opacity:.75}
.nav{display:flex;align-items:center;gap:4px;flex:1;justify-content:center}
.nav-item{position:relative;background:transparent;border:none;color:rgba(255,255,255,.8);font-size:13px;font-weight:600;padding:7px 16px;border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:7px;transition:background .18s,color .18s;white-space:nowrap}
.nav-item:hover{background:rgba(255,255,255,.15);color:#fff}
.nav-item.active{background:#e03030;color:#fff;box-shadow:0 0 0 2px #fff,0 0 0 4px #e03030}
.nav-dropdown{position:relative}
.nav-dropdown .dropdown-menu{display:none;position:absolute;top:calc(100% + 8px);left:0;background:#fff;border-radius:10px;box-shadow:0 8px 28px rgba(30,58,138,.18);min-width:160px;overflow:hidden;z-index:200}
.nav-dropdown:hover .dropdown-menu{display:block}
.dropdown-menu a{display:flex;align-items:center;gap:8px;padding:11px 18px;font-size:13px;font-weight:500;color:#1e2a4a;text-decoration:none;cursor:pointer;transition:background .14s}
.dropdown-menu a:hover{background:#eef2ff;color:#1e3a8a}
.topbar-right{min-width:180px;text-align:right;color:rgba(255,255,255,.85);font-size:13px}
.topbar-right strong{color:#fff;font-size:15px}

/* ── Pages ── */
.page{display:none;padding:28px 32px 48px}
.page.visible{display:block}

/* ── Card ── */
.card{background:#fff;border-radius:14px;box-shadow:0 2px 12px rgba(30,58,138,.08);margin-bottom:24px;overflow:hidden}
.card-header{display:flex;align-items:center;gap:10px;padding:16px 24px;border-bottom:1px solid #e8edf5;background:#f7f9ff}
.card-header h2{font-size:15px;font-weight:700;color:#1e2a4a}
.card-body{padding:22px 24px}

/* ── Import zone ── */
.import-zone{border:2px dashed #a0b0e0;border-radius:12px;padding:28px 20px;text-align:center;background:#f7f9ff;cursor:pointer;transition:border-color .2s,background .2s;margin-bottom:8px}
.import-zone:hover,.import-zone.dragover{border-color:#2b4fbd;background:#eef2ff}
.import-zone .upload-icon{font-size:36px;margin-bottom:8px}
.import-zone p{color:#4a6090;font-size:13.5px;line-height:1.6}
.import-zone p strong{color:#1e3a8a}
#fileInput{display:none}
.import-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px}
.btn-import{background:#2b4fbd;color:#fff;border:none;border-radius:8px;padding:9px 20px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;transition:background .18s}
.btn-import:hover{background:#1e3a8a}
.btn-template{background:transparent;color:#2b4fbd;border:1.5px solid #2b4fbd;border-radius:8px;padding:8px 18px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all .18s}
.btn-template:hover{background:#eef2ff}
.import-hint{font-size:11.5px;color:#7a8fbe}

/* ── Summary chips ── */
.summary-row{display:flex;gap:14px;margin-bottom:18px;flex-wrap:wrap}
.chip{display:flex;align-items:center;gap:10px;background:#fff;border-radius:10px;padding:12px 18px;box-shadow:0 2px 8px rgba(30,58,138,.08);border-left:4px solid transparent}
.chip.total{border-left-color:#2b4fbd}.chip.green{border-left-color:#16a34a}.chip.yellow{border-left-color:#d97706}.chip.red{border-left-color:#dc2626}.chip.nodata{border-left-color:#94a3b8}
.chip-val{font-size:22px;font-weight:800;color:#1e2a4a}
.chip-lbl{font-size:11.5px;color:#7a8fbe;font-weight:600;margin-top:1px}

/* ── Filter bar ── */
.filter-bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.filter-bar input,.filter-bar select{border:1.5px solid #d0d9ef;border-radius:8px;padding:8px 12px;font-size:13px;color:#1e2a4a;background:#fff;outline:none;transition:border-color .18s}
.filter-bar input:focus,.filter-bar select:focus{border-color:#2b4fbd}
.filter-bar input{width:200px}

/* ── Pagination ── */
.pager{display:flex;align-items:center;gap:8px;padding:14px 24px;border-top:1px solid #e8edf5;background:#f7f9ff;flex-wrap:wrap}
.pager-info{font-size:13px;color:#7a8fbe;margin-right:auto}
.pager-btn{background:#fff;border:1.5px solid #d0d9ef;border-radius:7px;padding:6px 14px;font-size:13px;font-weight:600;cursor:pointer;color:#1e2a4a;transition:all .16s}
.pager-btn:hover:not(:disabled){background:#eef2ff;border-color:#2b4fbd;color:#2b4fbd}
.pager-btn:disabled{opacity:.4;cursor:default}
.pager-btn.active{background:#2b4fbd;color:#fff;border-color:#2b4fbd}

/* ── Table ── */
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
thead tr{background:#1e3a8a;color:#fff}
thead th{padding:11px 12px;text-align:left;font-weight:600;white-space:nowrap;font-size:12px;letter-spacing:.3px}
tbody tr{border-bottom:1px solid #edf0f7;transition:background .12s}
tbody tr:hover{background:#f7f9ff}
tbody td{padding:10px 12px;vertical-align:middle}
.employee-name-link{background:transparent;border:0;color:#1e3a8a;font:inherit;font-weight:800;cursor:pointer;text-align:left;padding:0;text-decoration:none;border-radius:6px}
.employee-name-link:hover{color:#2b4fbd;text-decoration:underline;text-underline-offset:3px}
.flag{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:99px;font-size:11px;font-weight:700}
.flag.green{background:#d1fae5;color:#065f46}
.flag.yellow{background:#fef9c3;color:#92400e}
.flag.orange{background:#ffedd5;color:#9a3412}
.flag.red{background:#fee2e2;color:#991b1b}
.flag.nodata{background:#f1f5f9;color:#64748b}
.flag.blue{background:#e0f2fe;color:#0369a1}
.flag::before{content:'●';font-size:8px}
.score-cell{font-weight:700;font-size:13px}
.mini-bar-wrap{display:flex;align-items:center;gap:8px}
.mini-bar{flex:1;height:6px;background:#e8edf5;border-radius:99px;overflow:hidden;min-width:60px}
.mini-bar-fill{height:100%;border-radius:99px}
.btn-edit{background:#eef2ff;color:#2b4fbd;border:1.5px solid #c7d3f5;border-radius:7px;padding:4px 12px;font-size:11.5px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:4px;transition:all .16s}
.btn-edit:hover{background:#2b4fbd;color:#fff;border-color:#2b4fbd}
.period-badge{display:inline-block;background:#eef2ff;color:#2b4fbd;border-radius:6px;padding:2px 8px;font-size:11.5px;font-weight:700}

/* ── Action bar ── */
.action-bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:16px 24px;border-top:1px solid #e8edf5;background:#f7f9ff}
.btn-save{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;border:none;border-radius:9px;padding:10px 26px;font-size:13.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:7px;box-shadow:0 3px 10px rgba(22,163,74,.3);transition:opacity .18s,transform .1s}
.btn-save:hover{opacity:.9;transform:translateY(-1px)}
.btn-clear{background:#fff;color:#dc2626;border:1.5px solid #fca5a5;border-radius:9px;padding:9px 22px;font-size:13.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:7px;transition:all .18s}
.btn-clear:hover{background:#fee2e2;border-color:#dc2626}
.btn-export{background:#fff;color:#059669;border:1.5px solid #6ee7b7;border-radius:9px;padding:9px 20px;font-size:13.5px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:7px;transition:all .18s;margin-left:auto}
.btn-export:hover{background:#ecfdf5;border-color:#059669}

/* ── Modal ── */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(10,20,60,.45);z-index:500;align-items:center;justify-content:center}
.modal-bg.open{display:flex}
.modal{background:#fff;border-radius:16px;padding:30px 26px;width:520px;max-width:95vw;box-shadow:0 16px 48px rgba(30,58,138,.2);position:relative}
.modal h3{font-size:16px;font-weight:700;margin-bottom:18px;color:#1e2a4a}
.modal label{display:block;font-size:12px;font-weight:600;color:#4a6090;margin-bottom:3px}
.modal input,.modal select{width:100%;border:1.5px solid #d0d9ef;border-radius:8px;padding:8px 12px;font-size:13px;color:#1e2a4a;margin-bottom:12px;outline:none}
.modal input:focus,.modal select:focus{border-color:#2b4fbd}
.modal .readonly-field{background:#f7f9ff;color:#64748b;font-size:12.5px}
.modal-row{display:flex;gap:12px}
.modal-row>*{flex:1}
.modal-actions{display:flex;gap:10px;margin-top:6px}
.btn-modal-save{background:#2b4fbd;color:#fff;border:none;border-radius:8px;padding:10px 24px;font-size:13px;font-weight:700;cursor:pointer;flex:1}
.btn-modal-save:hover{background:#1e3a8a}
.btn-modal-cancel{background:#f0f2f7;color:#4a6090;border:none;border-radius:8px;padding:10px 24px;font-size:13px;font-weight:600;cursor:pointer}
.btn-modal-cancel:hover{background:#e0e5f0}
.modal-close{position:absolute;top:14px;right:18px;font-size:20px;cursor:pointer;color:#9aaac8;background:none;border:none}

/* ── Placeholder ── */
.placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 24px;color:#7a8fbe}
.placeholder .ph-icon{font-size:56px;margin-bottom:14px;opacity:.5}
.placeholder h3{font-size:18px;font-weight:700;margin-bottom:6px;color:#1e2a4a}
.placeholder p{font-size:13.5px;text-align:center;max-width:340px;line-height:1.6}

/* ── KPI Sub-tabs ── */
.subtab-bar{display:flex;gap:4px;padding:16px 24px 0;background:#f7f9ff;border-bottom:2px solid #e8edf5;flex-wrap:wrap}
.subtab-btn{background:transparent;border:none;border-bottom:3px solid transparent;padding:9px 20px;font-size:13px;font-weight:600;color:#7a8fbe;cursor:pointer;border-radius:8px 8px 0 0;transition:all .18s;margin-bottom:-2px}
.subtab-btn:hover{color:#2b4fbd;background:rgba(43,79,189,.07)}
.subtab-btn.active{color:#2b4fbd;border-bottom-color:#2b4fbd;background:#fff}
.subtab-content{display:none}.subtab-content.visible{display:block}

/* ── eKPI Form ── */
.ekpi-form{padding:24px}
.form-section{margin-bottom:28px}
.form-section-title{font-size:13px;font-weight:800;color:#1e3a8a;letter-spacing:.5px;text-transform:uppercase;padding:8px 14px;background:#eef2ff;border-left:4px solid #2b4fbd;border-radius:0 8px 8px 0;margin-bottom:16px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-grid.cols3{grid-template-columns:1fr 1fr 1fr}
.form-field{display:flex;flex-direction:column;gap:4px}
.form-field.full{grid-column:1/-1}
.form-field label{font-size:11.5px;font-weight:700;color:#4a6090;text-transform:uppercase;letter-spacing:.3px}
.form-field input,.form-field select,.form-field textarea{border:1.5px solid #d0d9ef;border-radius:8px;padding:8px 12px;font-size:13px;color:#1e2a4a;background:#fff;outline:none;transition:border-color .18s;font-family:inherit}
.form-field input:focus,.form-field select:focus,.form-field textarea:focus{border-color:#2b4fbd;box-shadow:0 0 0 3px rgba(43,79,189,.1)}
.form-field textarea{resize:vertical;min-height:68px}
.form-field input[readonly],.form-field input.readonly{background:#f7f9ff;color:#64748b;cursor:default}

/* ── Outcome Table ── */
.outcome-table-wrap{overflow-x:auto;border-radius:10px;border:1.5px solid #e0e7f5}
.outcome-table{width:100%;border-collapse:collapse;font-size:12.5px;min-width:1680px}
.outcome-table thead tr{background:#a6a6a6;color:#000}
.outcome-table thead th{padding:9px 10px;text-align:center;font-weight:800;font-size:11.5px;white-space:nowrap;border:1px solid #111;background:#a6a6a6;color:#000;vertical-align:middle}
.outcome-table thead th:first-child{text-align:center;width:36px}
.outcome-table tbody tr{border-bottom:1px solid #edf0f7;transition:background .12s}
.outcome-table tbody tr:hover{background:#f7f9ff}
.outcome-table tbody td{padding:7px 8px;vertical-align:middle;border:1px solid #111}
.outcome-table tfoot tr{background:#fff;font-weight:700}
.outcome-table tfoot td{padding:9px 10px;font-size:12.5px;border:1px solid #111}
.outcome-table input,.outcome-table select{border:1.5px solid #d0d9ef;border-radius:6px;padding:5px 7px;font-size:12px;color:#1e2a4a;background:#fff;outline:none;width:100%;font-family:inherit;transition:border-color .15s}
.outcome-table input:focus,.outcome-table select:focus{border-color:#2b4fbd}
.outcome-table input[readonly]{background:#f0f4ff;color:#3a5bd6;font-weight:700;text-align:center;cursor:default}
.score-good{color:#16a34a;font-weight:700}
.score-ok{color:#d97706;font-weight:700}
.score-bad{color:#dc2626;font-weight:700}
.bobot-warn{color:#dc2626;font-size:11px;margin-top:4px;display:none}

/* ── Progress Month Cells ── */
.month-input{width:52px!important;text-align:center}


.outcome-table .month-head{background:#d9d9d9!important;color:#000!important;font-weight:800}
.outcome-table .blank-head{background:#d9d9d9!important;color:#000!important}
.outcome-table .note-small{display:block;font-size:10px;font-style:italic;font-weight:500;line-height:1.15;margin-top:2px}
.outcome-table .arc-head,.outcome-table .arc-subhead{background:#bfbfbf!important;color:#000!important}
.outcome-table .score-area{background:#e7e7e7}
.outcome-table input[readonly]{background:#e7e7e7;color:#000;font-weight:700;text-align:center;cursor:default}

/* ── nilai akhir badge ── */
.nilai-badge{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0;border-radius:0;font-size:18px;font-weight:900;border:0;background:transparent!important;color:#000!important;margin-top:0}
.nilai-badge.green{background:#d1fae5;color:#065f46;border-color:#6ee7b7}
.nilai-badge.yellow{background:#fef9c3;color:#92400e;border-color:#fde047}
.nilai-badge.red{background:#fee2e2;color:#991b1b;border-color:#fca5a5}
.nilai-badge.nodata{background:#f1f5f9;color:#64748b;border-color:#cbd5e1}

/* ── eKPI list table ── */
.ekpi-list-table{width:100%;border-collapse:collapse;font-size:13px}
.ekpi-list-table thead tr{background:#1e3a8a;color:#fff}
.ekpi-list-table thead th{padding:10px 12px;text-align:left;font-weight:600;font-size:12px;white-space:nowrap}
.ekpi-list-table tbody tr{border-bottom:1px solid #edf0f7;transition:background .12s}
.ekpi-list-table tbody tr:hover{background:#f7f9ff}
.ekpi-list-table tbody td{padding:9px 12px;vertical-align:middle}
.btn-view{background:#eef2ff;color:#2b4fbd;border:1.5px solid #c7d3f5;border-radius:7px;padding:4px 12px;font-size:11.5px;font-weight:600;cursor:pointer;transition:all .16s;margin-right:4px}
.btn-view:hover{background:#2b4fbd;color:#fff}
.btn-del{background:#fff0f0;color:#dc2626;border:1.5px solid #fca5a5;border-radius:7px;padding:4px 10px;font-size:11.5px;font-weight:600;cursor:pointer;transition:all .16s}
.btn-del:hover{background:#fee2e2}

.kpi-action-cell{display:flex;gap:8px;align-items:center;justify-content:center;white-space:nowrap}
.btn-kpi-edit{background:#eef2ff;color:#2b4fbd;border:1.5px solid #c7d3f5;border-radius:7px;padding:5px 12px;font-size:11.5px;font-weight:800;cursor:pointer;transition:all .16s;display:inline-flex;align-items:center;gap:4px}
.btn-kpi-edit:hover{background:#2b4fbd;color:#fff;border-color:#2b4fbd}
.btn-kpi-preview{background:#fff;color:#1e3a8a;border:1.5px solid #a7b7ef;border-radius:7px;padding:5px 12px;font-size:11.5px;font-weight:800;cursor:pointer;transition:all .16s;display:inline-flex;align-items:center;gap:4px}
.btn-kpi-preview:hover{background:#f7f9ff;border-color:#2b4fbd;color:#2b4fbd}
.kpi-preview-modal{width:1100px;max-width:96vw;max-height:90vh;overflow-y:auto;padding:0;border-radius:16px}
.kpi-preview-head{padding:20px 24px 14px;border-bottom:1px solid #e8edf5;background:#fff;position:sticky;top:0;z-index:3}
.kpi-preview-head h3{font-size:18px;margin:0 0 4px;color:#1e2a4a}
.kpi-preview-sub{font-size:12px;color:#64748b;line-height:1.5}
.kpi-preview-body{padding:18px 22px 22px;background:#fff;color:#1e2a4a}
.kpi-preview-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:14px}
.kpi-preview-field{background:#f7f9ff;border:1px solid #e0e7f5;border-radius:8px;padding:9px 12px}
.kpi-preview-label{font-size:10.5px;text-transform:uppercase;font-weight:800;color:#4a6090;letter-spacing:.3px;margin-bottom:3px}
.kpi-preview-value{font-size:13px;font-weight:700;color:#1e2a4a;word-break:break-word}
.kpi-preview-mission{border:1px solid #e0e7f5;border-radius:10px;background:#fafbff;padding:12px 14px;font-size:13px;line-height:1.55;min-height:48px;margin-bottom:14px;white-space:pre-wrap}
.kpi-preview-table-wrap{overflow-x:auto;border:1.5px solid #e0e7f5;border-radius:10px}
.kpi-preview-table{width:100%;border-collapse:collapse;font-size:12px;min-width:1180px}
.kpi-preview-table th{background:#1e3a8a;color:#fff;padding:8px 9px;text-align:center;border-right:1px solid rgba(255,255,255,.15);font-size:11px;white-space:nowrap}
.kpi-preview-table td{border-bottom:1px solid #edf0f7;border-right:1px solid #edf0f7;padding:8px 9px;vertical-align:top;background:#fff}
.kpi-preview-empty{padding:40px 20px;text-align:center;color:#7a8fbe;background:#f7f9ff;border:1.5px dashed #c7d3f5;border-radius:12px}
.kpi-preview-actions{display:flex;gap:10px;justify-content:flex-end;padding:12px 22px 18px;border-top:1px solid #e8edf5;background:#f8fafc;position:sticky;bottom:0}
@media(max-width:780px){.kpi-preview-grid{grid-template-columns:1fr}.kpi-action-cell{justify-content:flex-start}.kpi-preview-body{padding:14px}.kpi-preview-table{font-size:11px}}



/* ── KPI Top Actions ── */
.kpi-subtab-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:0 24px;background:#f7f9ff;border-bottom:2px solid #e8edf5;flex-wrap:wrap}
.kpi-subtab-head .subtab-bar{padding:16px 0 0;border-bottom:0;background:transparent}
.kpi-top-actions{display:flex;flex-direction:column;gap:8px;align-items:flex-end;padding:14px 0 12px;margin-left:auto}
.btn-download-kpi,.btn-merge-kpi{border:none;border-radius:10px;padding:9px 18px;font-size:13px;font-weight:800;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-width:190px;box-shadow:0 4px 12px rgba(30,58,138,.15);transition:opacity .18s,transform .12s,box-shadow .18s}
.btn-download-kpi{background:#15803d;color:#fff}
.btn-merge-kpi{background:#2b4fbd;color:#fff}
.btn-download-kpi:hover,.btn-merge-kpi:hover{opacity:.92;transform:translateY(-1px);box-shadow:0 6px 16px rgba(30,58,138,.22)}
.merge-help{font-size:11px;color:#7a8fbe;text-align:right;max-width:270px;line-height:1.35}

/* ── Rekap Data: ARC × KPI ── */
.rekap-help{font-size:12.5px;color:#4a6090;margin-bottom:16px;line-height:1.45}
.rekap-card{height:100%}
.rekap-matrix{display:grid;grid-template-columns:64px repeat(4,1fr);gap:7px;align-items:stretch}
.rekap-axis-empty{font-size:11px;color:#7a8fbe}
.rekap-col-head,.rekap-row-head{font-size:11px;color:#3a4b75;text-align:center;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1.25}
.rekap-col-head{padding:2px 4px;min-height:34px}
.rekap-row-head{padding:4px 2px;min-height:72px;flex-direction:column}
